# GREEN-API Configuration Example
# 1. Register or log in at https://console.green-api.com/
# 2. Authorize your instance by scanning the QR code with WhatsApp (Linked Devices)
# 3. Copy your idInstance, apiTokenInstance, and host URL from the console dashboard
# 4. Fill in the values below or configure them directly via the in-app Settings modal

VITE_GREEN_ID_INSTANCE=your_id_instance_here
VITE_GREEN_API_TOKEN_INSTANCE=your_api_token_instance_here
VITE_GREEN_API_URL=""
